model Notification {
  id       String @id @default(uuid())
  type     NotificationType
  message  String
  isRead   Boolean @default(false)

  userId   String
  user     User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@map("notifications")
}


enum NotificationType {
  LIKE
  COMMENT
  FOLLOW
  MESSAGE
  SPONSORED
}
